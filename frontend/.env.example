# Copy to `.env` and fill in your values from the Supabase dashboard:
# Project Settings → API.
# These are baked into the renderer bundle at build time (Vite).
# The anon key is PUBLIC by design — it's protected by Row Level
# Security policies on the server side, not by being secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional — empty disables error reporting)
# Get DSN from sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_RATE=0
